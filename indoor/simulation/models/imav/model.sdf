<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="imav">
    <static>true</static>

    <!-- Mesh visual (rulebook scenery). Collision is the floor box + overlays so
         missing all.stl cannot leave the arena without physics. -->
    <link name="base_link">
      <collision name="floor_collision">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>14 7 0.1</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://imav/meshes/all.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="floor_red">
      <pose>0 0 -0.002 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>14 7 0.004</size></box></geometry>
          <material>
            <ambient>0.7 0.08 0.05 1</ambient>
            <diffuse>0.7 0.08 0.05 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
      </visual>
    </link>
    <!-- Fig.8 wallpaper: tiled quads (not one stretched 10 m box). -->
