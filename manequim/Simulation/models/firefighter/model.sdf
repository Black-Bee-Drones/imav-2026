<?xml version="1.0"?>
<sdf version="1.10">
    <model name="firefighter">

        <static>true</static>

        <link name="body">

            <!-- Modelo visual -->
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/firefighter.glb</uri>
                    </mesh>
                </geometry>
            </visual>

            <!-- Colisão simples -->
            <!-- <collision name="collision">
                <geometry>
                    <box>
                        <size>0.5 0.4 1.8</size>
                    </box>
                </geometry>
            </collision> -->
            <collision name="collision">
                <geometry>
                  <mesh>
                    <uri>meshes/firefighter.glb</uri>
                  </mesh>
                </geometry>
            </collision>

        </link>

    </model>
</sdf>